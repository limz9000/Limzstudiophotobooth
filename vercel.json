{
"version": 2,
"cleanUrls": true,
"rewrites": [
{
"source": "/",
"destination": "/js.html"
},
{
"source": "/gallery/:slug/:photoId",
"destination": "/js.html?slug=:slug&photoId=:photoId"
},
{
"source": "/gallery/:slug",
"destination": "/js.html?slug=:slug"
},
{
"source": "/monitor/:slug",
"destination": "/js.html?view=slideshow&slug=:slug"
}
]
}
